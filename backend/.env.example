DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/durga"
PORT=5000

# Optional provider-backed road incident and flood feeds. Each endpoint must
# return { "hazards": [{ "roadId": "...", "type": "...", "severity": "...", "blocked": true }] }.
INCIDENTS_API_URL=
INCIDENTS_API_KEY=
FLOOD_API_URL=
FLOOD_API_KEY=

# Optional override for the no-key weather provider.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Gemini AI decision-support layer. Never expose this key to Vite/React.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
